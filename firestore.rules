// MIGRATION 2026-05-19: Firebase gesperrt — App läuft jetzt auf Appwrite.
// Alle Schreiboperationen deaktiviert. Lesen weiterhin erlaubt (read-only).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
